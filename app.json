{
  "expo": {
    "name": "FaithDate",
    "slug": "faithdate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "faithdate",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.christianappsfamily.faithdate",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "FaithDate",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.christianappsfamily.faithdate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7EE"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
